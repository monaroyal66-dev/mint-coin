---
import PageLayout from '../../layouts/PageLayout.astro';

const sections = [
  {
    title: 'アクセス解析について',
    body: [
      '当サイトでは、サイトの利用状況を把握し、内容の改善に役立てるため、Google Analyticsを使用しています。',
      'Google AnalyticsはCookieを使用して利用状況に関する情報を収集しますが、個人を特定する情報は収集していません。',
      '取得された情報は、Google社のプライバシーポリシーに基づいて管理されます。',
    ],
  },
  {
    title: '個人情報の利用目的',
    body: [
      '当サイトでは、お問い合わせの際に、氏名、メールアドレス等の個人情報をご入力いただく場合があります。',
      '取得した個人情報は、お問い合わせへの回答や必要な連絡のために利用し、それ以外の目的では利用しません。',
    ],
  },
];
---

<PageLayout
  title="プライバシーポリシー"
  description="MINT-COINにおける個人情報の取り扱い、アクセス解析についてのプライバシーポリシーです。"
>
  <!-- Page Hero -->
  <section class="bg-ivory py-12 border-b border-parchment">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-gray-400 mb-4">
        <a href="/" class="hover:text-navy-700 transition-colors">ホーム</a>
        <span class="mx-2">›</span>
        <span class="text-gray-600">プライバシーポリシー</span>
      </nav>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-navy-900">プライバシーポリシー</h1>
    </div>
  </section>

  <!-- Content -->
  <section class="bg-white py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {sections.map(({ title, body }) => (
        <div>
          <div class="mb-5">
            <h2 class="font-serif text-xl font-semibold text-navy-900 mb-3">{title}</h2>
            <div class="w-8 h-px bg-gold-500"></div>
          </div>
          <div class="space-y-3">
            {body.map((line) => (
              <p class="text-sm text-gray-600 leading-loose">{line}</p>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</PageLayout>
